        "jsCode": "// 1️⃣ Tomar el texto del JSON generado por Gemini\nlet raw = $json.content?.parts?.[0]?.text || \"\";\n\n// 2️⃣ Limpiar: quitar backticks, etiquetas ```json y espacios\nraw = raw\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// 3️⃣ Intentar parsear el texto a objeto JSON\nlet factura;\ntry {\n  factura = JSON.parse(raw);\n} catch (error) {\n  throw new Error(\"❌ No se pudo convertir el texto a JSON válido.\\nContenido recibido:\\n\" + raw);\n}\n\n// 4️⃣ Campos generales de la factura\nconst generales = {\n  No_factura: factura.No_factura || \"\",\n  fecha: factura.fecha || \"\",\n  proveedor: factura.proveedor || \"\",\n  subtotal: factura.subtotal || \"\",\n  iva: factura.iva || \"\",\n  total: factura.total || \"\",\n  moneda: factura.moneda || \"\",\n  metodo_pago: factura.metodo_pago || \"\",\n  vencimiento_credito: factura.vencimiento_credito || null,\n};\n\n// 5️⃣ Crear items por cada artículo\nconst items = [];\nfor (const art of factura.articulos || []) {\n  items.push({\n    json: {\n      ...generales,\n      No_parte: art.No_parte || \"\",\n      concepto: art.concepto || \"\",\n      cantidad: art.cantidad || \"\",\n      precio_unitario: art.precio_unitario || \"\",\n      categoria: art.categoria || \"\",\n    },\n  });\n}\n\nreturn items;"
      },
